# FlowCast Environment Configuration Template
# Copy this file to .env and configure your credentials. Do not commit actual secrets to git.

# Server Port (default: 8088)
PORT=8088

# TomTom Developer Credentials
# Get your API key at: https://developer.tomtom.com/
FLOWCAST_TOMTOM_SERVER_KEY=
FLOWCAST_TOMTOM_BROWSER_KEY=
FLOWCAST_TOMTOM_SEARCH_KEY=

# Open-Meteo Weather Service (free public open-data; no API key required)
FLOWCAST_OPEN_METEO_ENABLED=true

# City Center & Coordinates (Defaults to Visakhapatnam, Andhra Pradesh, India)
FLOWCAST_DEFAULT_CITY=Visakhapatnam
FLOWCAST_LATITUDE=17.6868
FLOWCAST_LONGITUDE=83.2185

# PostgreSQL / PostGIS Database Configuration (Optional: docker compose up -d)
FLOWCAST_DB_URL=jdbc:postgresql://localhost:5432/flowcast
FLOWCAST_DB_USERNAME=flowcast
FLOWCAST_DB_PASSWORD=change-me
FLOWCAST_FLYWAY_ENABLED=false

# Historical Observation Collector & Tribuo Machine Learning Permissions
# Set both to true only if you grant explicit permission to record observations and train models
FLOWCAST_TRAFFIC_HISTORY_ENABLED=false
FLOWCAST_TRAFFIC_TRAINING_PERMISSION=false
FLOWCAST_MIN_TRAINING_SAMPLES=1000
